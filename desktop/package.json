{
  "name": "vera-desktop",
  "version": "0.1.0-alpha.4",
  "private": true,
  "engines": {
    "node": ">=22 <26"
  },
  "type": "module",
  "description": "VERA desktop frontend and backend integration boundary",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:ui": "node tests/ui/run-acceptance.mjs",
    "lint": "biome check src tests electron.vite.config.ts vitest.config.ts",
    "postinstall": "node node_modules/electron/install.js && patch-package",
    "check:boundary": "node scripts/check-boundary.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@lexical/extension": "0.52.0",
    "@lexical/history": "0.52.0",
    "@lexical/react": "0.52.0",
    "@lexical/rich-text": "0.52.0",
    "katex": "0.19.1",
    "lexical": "0.52.0",
    "markstream-react": "0.0.55",
    "mermaid": "12.3.0",
    "monaco-editor": "0.55.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "semver": "7.8.5",
    "stream-markdown": "0.0.16",
    "stream-monaco": "0.0.49",
    "thinking-orbs": "0.3.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.8.12",
    "electron-vite": "5.0.0",
    "happy-dom": "21.0.4",
    "patch-package": "8.0.1",
    "playwright-core": "1.65.0",
    "shiki": "4.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "5.1.1"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
